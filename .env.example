# =============================================================================
# Root .env — untuk service yang dijalankan DI HOST (`go run ./service/<svc>`).
#
# Cara pakai:
#     cp .env.example .env
#
# Kalau seluruh stack jalan lewat Docker Compose, file ini tidak dipakai —
# container membaca deployments/local/docker.env (lihat file .example-nya).
#
# CATATAN PENTING: DB_HOST / DB_PORT / DB_NAME base sengaja TIDAK ada di sini.
# Service memilih bounded context lewat key DB_<CONTEXT>_* dan sengaja gagal
# start kalau key-nya kosong, supaya tidak diam-diam nyambung ke database
# context lain. Jangan tambahkan fallback generic.
# =============================================================================

# --- PostgreSQL: 3 bounded context, masing-masing di depan PgBouncer ---
# Port host di bawah adalah port PgBouncer yang di-map docker-compose.yml
# (6432/6433/6434). PostgreSQL sendiri TIDAK di-publish ke host.
DB_DRIVER=postgres
DB_USERNAME=postgres
DB_PASSWORD=password

DB_IDENTITY_HOST=localhost
DB_IDENTITY_PORT=6432
DB_IDENTITY_NAME=pg_identity

DB_PAYMENT_HOST=localhost
DB_PAYMENT_PORT=6433
DB_PAYMENT_NAME=pg_payment

DB_FINANCIAL_HOST=localhost
DB_FINANCIAL_PORT=6434
DB_FINANCIAL_NAME=pg_financial

# Client-side pool limits (harus lebih kecil dari budget pooler)
DB_MAX_OPEN_CONNS=100
DB_MIN_IDLE_CONNS=20
DB_CONN_MAX_LIFETIME=30m

# --- Secrets ---
SECRET_KEY=change-me

# --- Kafka ---
KAFKA_BROKERS=localhost:9092

# --- gRPC: alamat dial dari host (apigateway) ---
GRPC_AUTH_ADDR=localhost:50051
GRPC_ROLE_ADDR=localhost:50052
GRPC_CARD_ADDR=localhost:50053
GRPC_MERCHANT_ADDR=localhost:50054
GRPC_USER_ADDR=localhost:50055
GRPC_SALDO_ADDR=localhost:50056
GRPC_TOPUP_ADDR=localhost:50057
GRPC_TRANSACTION_ADDR=localhost:50058
GRPC_TRANSFER_ADDR=localhost:50059
GRPC_WITHDRAW_ADDR=localhost:50060

# --- gRPC: port bind tiap service ---
GRPC_AUTH_PORT=50051
GRPC_ROLE_PORT=50052
GRPC_CARD_PORT=50053
GRPC_MERCHANT_PORT=50054
GRPC_USER_PORT=50055
GRPC_SALDO_PORT=50056
GRPC_TOPUP_PORT=50057
GRPC_TRANSACTION_PORT=50058
GRPC_TRANSFER_PORT=50059
GRPC_WITHDRAW_PORT=50060

# --- Redis cluster (6 node) ---
REDIS_ADDRS=localhost:6379
REDIS_PASSWORD=dragon_knight
REDIS_DB=0

# --- ClickHouse (stats-reader / stats-writer) ---
CLICKHOUSE_ADDR=localhost:9000
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USERNAME=dragon
CLICKHOUSE_PASSWORD=dragon_knight

# --- Observability ---
OTEL_ENDPOINT=localhost:4317
PYROSCOPE_SERVER=http://localhost:4040

# --- SMTP (email worker). Isi dengan kredensial milikmu sendiri. ---
SMTP_SERVER=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
